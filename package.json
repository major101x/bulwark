{
  "name": "bulwark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liquidation-defense keeper that executes onchain through KeeperHub, and declines to act when the gas is not worth it",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test agent/*.test.ts chaos/*.test.ts",
    "agent": "tsx agent/loop.ts",
    "chaos": "tsx chaos/harness.ts",
    "typecheck": "tsc --noEmit",
    "first-tx": "tsx starter-template/first-tx.ts",
    "pos:status": "tsx scripts/status.ts",
    "pos:open": "tsx scripts/open-position.ts",
    "pos:fund-keeper": "tsx scripts/fund-keeper.ts",
    "pos:danger": "tsx scripts/danger.ts",
    "pos:evaluate": "tsx scripts/evaluate.ts",
    "chaos:fund": "tsx scripts/fund-chaos.ts",
    "chaos:unstick": "tsx scripts/unstick.ts",
    "agent:webhook": "tsx agent/index.ts",
    "dashboard": "tsx dashboard/server.ts",
    "ledger:backfill": "tsx scripts/backfill-ledger.ts",
    "mint": "tsx starter-template/mint-test-tokens.ts",
    "site:build": "tsx site/build.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
