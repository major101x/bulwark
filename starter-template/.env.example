# Copy this file to .env and fill in the one required value.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Sign up at https://app.keeperhub.com, then profile -> API keys.
# Starts with "kh_".
KEEPERHUB_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL. The defaults are fine for a first run.
# ---------------------------------------------------------------------------

# Where the API lives. Only change this if you were told to.
# KEEPERHUB_API_URL=https://app.keeperhub.com

# 11155111 is Sepolia, Ethereum's public test network.
# CHAIN_ID=11155111

# How much ETH to send yourself. Zero by default, so you need no funds and no
# faucet: KeeperHub sponsors the gas. Raise it only after you have testnet ETH.
# AMOUNT=0

# Idempotency key for the transaction. Leave this unset. It is derived from the
# chain, wallet and amount, so re-running replays the first result rather than
# sending a second transaction. Set it explicitly to force a genuinely new one.
# FIRST_TX_KEY=
