# ---------------------------------------------------------------------------
# Bulwark configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- KeeperHub -------------------------------------------------------------
# Create at app.keeperhub.com -> profile -> API keys
KEEPERHUB_API_KEY=
KEEPERHUB_API_URL=https://app.keeperhub.com

# Workflow IDs, filled in after you build them in the visual editor
WF_HF_WATCH=
WF_RESCUE_REPAY=
WF_RESCUE_COLLATERAL=
WF_ATTEST_MAINNET=

# --- Watched position (Sepolia) --------------------------------------------
# The wallet whose Aave position we defend. Your MetaMask address.
WATCHED_WALLET=
# Aave V3 Sepolia Pool. VERIFY against https://aave.com/docs before use.
AAVE_POOL_SEPOLIA=
# Asset we borrowed (repay path) and asset we supplied (collateral path)
DEBT_ASSET=
COLLATERAL_ASSET=

# --- Chains ----------------------------------------------------------------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# --- Mainnet attestation ---------------------------------------------------
# Address of GuardianLog.sol once deployed
GUARDIAN_LOG_ADDRESS=

# --- Chaos harness ONLY ----------------------------------------------------
# Throwaway Sepolia key for the naive ethers.js baseline. NEVER a real key.
# The KeeperHub path never needs this: keys stay in Turnkey enclaves.
CHAOS_BASELINE_PRIVATE_KEY=

# --- Agent server ----------------------------------------------------------
AGENT_PORT=8787
# Set to 1 to compute and log decisions without executing anything.
DRY_RUN=1
